---
// App shell: page, column and step back, in a frame with the bar, the mark menu and the footer.
// Shown in a frame on this page; on a real page the shell is the body.
import Notes from "./Notes.astro";

const page = `
<body class="r-page">
  <header class="r-bar">
    <nav class="r-crumbs" aria-label="Breadcrumb"><ol>
      <li><a class="r-btn r-crumb-root" href="/">Home</a></li>
      <li><a class="r-btn" href="/jobs/" aria-current="page">Jobs</a></li>
    </ol></nav>
    <div class="r-bar-end">
      <div class="r-group"><button type="button" class="r-btn r-cancel">Cancel</button><button type="button" class="r-btn">Run again</button></div>
      <details class="r-menu r-mark">…</details>
    </div>
  </header>
  <main class="r-column">
    <p>Text, at most --r-measure wide.</p>
    <div class="r-card r-step-back">…</div>
  </main>
  <footer class="r-foot"><a href="https://www.enterprise-r.com">Enterprise-R</a></footer>
</body>`;

const measure = `
:root {
  --r-measure: 880px;     /* the text width */
  --r-text-min: 26px;     /* the least inset from the window */
  --r-text-pad: 1rem;     /* the one inset below 40rem */
  --r-box-gap: 4px;       /* room for the glow outside a box */
  --r-box-pad: calc(var(--r-text-pad) - var(--r-box-gap));
  --r-text-inline: max(var(--r-text-min), calc((100% - var(--r-measure)) / 2));
  --r-bar-inline: calc(var(--r-text-inline) - var(--r-box-pad));
}
/* A page whose bar wraps measures it and sets: */
:root { --r-bar-h: 5.3rem; }`;

---
<section class="sc-section" id="shell">
  <h2 class="sc-label">App shell</h2>
  <p class="sc-prose">The bar, the column and the footer. Only the root crumb differs from site to site.</p>
  <div class="r-page sc-frame">
    <header class="r-bar">
      <nav class="r-crumbs" aria-label="Breadcrumb"><ol>
        <li><a class="r-btn r-crumb-root" href="#shell">Home</a></li>
        <li><a class="r-btn" href="#shell" aria-current="page">Jobs</a></li>
      </ol></nav>
      <div class="r-bar-end">
        <div class="r-group"><button type="button" class="r-btn r-cancel">Cancel</button><button type="button" class="r-btn">Run again</button></div>
        <details class="r-menu r-mark sc-mark">
          <summary aria-label="Menu" aria-haspopup="menu"><img src="/assets/logo-chipped.svg" alt="" width="32" height="32"></summary>
          <div class="r-menu-list" role="menu" aria-label="Menu">
            <details class="r-menu r-side">
              <summary class="r-btn r-clear" role="menuitem" aria-haspopup="menu">Theme</summary>
              <div class="r-menu-list" role="menu" aria-label="Theme">
                <button type="button" class="r-btn" role="menuitemradio" aria-checked="false">Light</button>
                <button type="button" class="r-btn" role="menuitemradio" aria-checked="true" aria-label="Dark-R"><span aria-hidden="true">Dark-<span class="r-name-r">®</span></span></button>
              </div>
            </details>
          </div>
        </details>
      </div>
    </header>
    <main class="r-column">
      <h3>Jobs</h3>
      <p>The column is at most <code>--r-measure</code> wide.</p>
      <div class="r-card r-step-back"><p>A card with <code>.r-step-back</code>.</p></div>
    </main>
    <footer class="r-foot"><a href="https://www.enterprise-r.com">Enterprise-R</a></footer>
  </div>
  {/* The frame (.sc-frame, ui.css) keeps the bar in place with --r-bar-h at 0, so the column starts a
       button's height below it. The mark is branding's hi-res chipped logo, which fills its view box, so
       .sc-mark sets the mark tokens to 1024, 1024 and 102. This site's public pages use their own bar and footer. */}

  <h3 class="sc-subhead">Page, column and step back</h3>
  <Notes
    markup={page}
    extra={measure}
    classes="`.r-page` on the body, `.r-column` on the content, `.r-step-back` on a box in the column."
    tokens="`--r-measure`, `--r-bar-h`, `--r-box-gap`."
    do="Set `--r-bar-h` when the bar wraps."
    dont="Give boxes in the column their own side margins."
  />

</section>
