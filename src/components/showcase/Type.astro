---
// Type: one typography, with impact and compact as optional levels.
// The woff2 files are subset to Latin and Latin Extended by the branding build.
import DarkR from "../DarkR.astro";
import Notes from "./Notes.astro";
import Enterprsr from "./Enterprsr.astro";

const scale = `
<p>Headings and body use Saira. Uppercase labels use Rajdhani.</p>`;

const impact = `
<h1 class="r-impact">Mission control</h1>

<div class="r-impact">
  <h1>Mission control</h1>
  <h2>A quiet view from orbit</h2>
  <h3>Engineering log</h3>
</div>`;

const compact = `
<p class="r-compact">We build small, careful things and send them a long way.</p>`;

const fonts = `
fonts/woff2/Enterprsr-Regular.woff2             Enterprsr, the ® of the name and the footer word
fonts/woff2/Saira-latin.woff2                   Saira, latin
fonts/woff2/Saira-latin-ext.woff2               Saira, latin-ext
fonts/woff2/Saira-vietnamese.woff2              Saira, Vietnamese
fonts/woff2/Saira-symbols.woff2                 Saira, symbols
fonts/woff2/Saira-Italic-latin.woff2            Saira italic, latin
fonts/woff2/Saira-Italic-latin-ext.woff2        Saira italic, latin-ext
fonts/woff2/Saira-Italic-vietnamese.woff2       Saira italic, Vietnamese
fonts/woff2/Saira-Italic-symbols.woff2          Saira italic, symbols
fonts/woff2/Rajdhani-SemiBold-latin.woff2       Rajdhani 600, latin
fonts/woff2/Rajdhani-SemiBold-latin-ext.woff2   Rajdhani 600, latin-ext
fonts/woff2/Rajdhani-SemiBold-devanagari.woff2  Rajdhani 600, Devanagari
fonts/woff2/Rajdhani-SemiBold-symbols.woff2     Rajdhani 600, symbols
fonts/woff2/Audiowide-Regular.woff2             Audiowide, impact
fonts/woff2/MonaspaceNeon.woff2                 Monaspace Neon, code`;

const body = "We build small, careful things and send them a long way. This is how body text reads on our dark background.";
---
<section class="sc-section" id="type">
  <h2 class="sc-label">Type</h2>

  <h3 class="sc-subhead">The scale</h3>
  <p class="sc-prose">Saira sets the headings and the body. Rajdhani sets the uppercase labels.</p>
  <div class="sc-type sc-scale">
    <span class="sc-cap"><b>h1</b> Green</span><h1>Mission control</h1>
    <span class="sc-cap"><b>h2</b> Bright</span><h2>A quiet view from orbit</h2>
    <span class="sc-cap"><b>h3</b> Magenta</span><h3>Engineering log</h3>
    <span class="sc-cap"><b>h4</b> label caps, Yellow</span><h4>Surfaces</h4>
    <span class="sc-cap"><b>h5</b> label caps, Light</span><h5>Instruments</h5>
    <span class="sc-cap"><b>h6</b> label caps, Dark</span><h6>Footnotes</h6>
    <span class="sc-cap"><b>Body</b></span><p>{body}</p>
    <span class="sc-cap"><b>Small</b></span><small>info<span class="at">@</span>enterprise-r.com · small print and captions</small>
    <span class="sc-cap"><b>Link</b></span><p>Read the <a href="#type">mission notes</a> before you start.</p>
    <span class="sc-cap"><b>Mark</b></span><p>The <mark>launch window</mark> opens at dawn.</p>
    <span class="sc-cap"><b>Keys</b></span><p>Press <kbd>Ctrl</kbd> + <kbd>K</kbd> to search.</p>
    <span class="sc-cap"><b>Prompt</b> <code>.r-prompt</code></span><p><span class="r-prompt">Click or press</span></p>
    <span class="sc-cap"><b>Code</b></span><p><code>--r-text</code></p>
    <span class="sc-cap"><b>Quote</b></span><blockquote>Make it so, but make it small.</blockquote>
    <span class="sc-cap"><b>List</b></span><ul><li>Plain lists keep the body text.</li><li>Nested items indent.</li></ul>
    <span class="sc-cap"><b>Definitions</b></span><dl><dt>Orbit</dt><dd>The path around a body.</dd><dt>Root</dt><dd>The lone R<span aria-hidden="true">, <span class="r-name-r">®</span></span>.</dd></dl>
    <span class="sc-cap"><b>Details</b></span><details><summary>Show the checklist</summary>Fuel, comms, crew.</details>
    <span class="sc-cap"><b>Figure</b></span><figure><img src="/assets/ui-language-roads.svg" width="690" height="590" alt="The roads of the UI language"><figcaption>A figure scales down to its container.</figcaption></figure>
    <span class="sc-cap"><b>Selection</b></span><p>Select this line to see the selection colors.</p>
  </div>
  <Notes
    markup={scale}
    classes="`.r-doc` around a document, for its measure and spacing only."
    tokens="`--r-font-text`, `--r-font-ui`, `--r-font-mono`, `--r-doc-measure` (68ch)."
    do="Write plain semantic HTML. Link `doc.css` after `base.css` only where documents are."
    dont="Pick a heading level for its look. Put app controls inside `.r-doc`."
  />

  <h3 class="sc-subhead">Impact</h3>
  <p class="sc-prose">Audiowide, the face the logotype is drawn from, is for a few words that should stand out.</p>
  <div class="sc-grid cols-2">
    <div>
      <p class="sc-cap"><b>Normal</b></p>
      <div class="sc-plain">
        <h1>Mission control</h1>
        <h2>A quiet view from orbit</h2>
        <h3>Engineering log</h3>
      </div>
    </div>
    <div>
      <p class="sc-cap"><b>Impact</b> <code>.r-impact</code></p>
      <div class="r-impact">
        <h1>Mission control</h1>
        <h2>A quiet view from orbit</h2>
        <h3>Engineering log</h3>
      </div>
    </div>
  </div>
  <Notes
    markup={impact}
    classes="`.r-impact` on a heading, or on a wrapper for h1 to h3. A page h1 uses it by default; an h1 in `.r-doc` does not."
    tokens="`--r-font-heading`."
    do="Use impact for a few words that should stand out."
    dont="Set a whole page in impact."
  />

  <h3 class="sc-subhead">Compact</h3>
  <p class="sc-prose">Compact narrows the text so more of a line fits.</p>
  <div class="sc-grid cols-2">
    <div class="sc-plain">
      <p class="sc-cap"><b>Normal</b></p>
      <h2>A quiet view from orbit</h2>
      <p>{body}</p>
    </div>
    <div class="sc-plain r-compact">
      <p class="sc-cap"><b>Compact</b> <code>.r-compact</code></p>
      <h2>A quiet view from orbit</h2>
      <p>{body}</p>
    </div>
  </div>
  <p class="sc-note">It switches on by itself on small screens.</p>
  <Notes
    markup={compact}
    classes="`.r-compact` when you want it on a wide screen. Body text uses it below 40rem, the bar below 52rem."
    do="Leave compact to the breakpoints unless you want it on a wide screen."
    dont="Force compact on impact lettering."
  />

  <h3 class="sc-subhead">Fonts</h3>
  <div class="sc-type sc-fonts">
    <span class="sc-cap"><b>Text</b></span><p class="sc-f-text">Saira</p>
    <span class="sc-cap"><b>Interface</b></span><p class="sc-f-ui">Rajdhani</p>
    <span class="sc-cap"><b>Impact</b></span><p class="sc-aw">Audiowide</p>
    <span class="sc-cap"><b>Code</b></span><p class="sc-f-mono">Monaspace Neon</p>
  </div>
  <Notes
    markup={fonts}
    do="Ship the licenses with the fonts."
    dont="Load the same faces from a font service as well."
  >
    <p>The theme loads <Enterprsr />, Saira (latin, latin-ext, Vietnamese), Rajdhani SemiBold (latin, latin-ext, Devanagari), Audiowide and Monaspace Neon from <code>../fonts/woff2/</code>. Saira includes a real italic. Faces are split by <code>unicode-range</code>.</p>
  </Notes>
</section>
