---
// Tables: the plain table of base.css and the key/value table (kv.css).
import Notes from "./Notes.astro";

const plain = `
<table>
  <caption>Crew on this watch</caption>
  <thead><tr><th>Name</th><th>Role</th><th class="r-num">Watch</th></tr></thead>
  <tbody>
    <tr><td>Beverly Crusher</td><td>Chief medical officer</td><td class="r-num">1</td></tr>
  </tbody>
</table>`;

const kv = `
<div class="r-kv"><table><tbody>
  <tr><th>name</th><td>Weekly report</td></tr>
  <tr><th>owner</th><td><table><tbody>
    <tr><th>team</th><td>Ops</td></tr>
    <tr><th>email</th><td>ops@example.com</td></tr>
  </tbody></table></td></tr>
</tbody></table></div>`;

---
<section class="sc-section" id="tables">
  <h2 class="sc-label">Tables</h2>
  <table>
    <caption>Crew on this watch</caption>
    <thead>
      <tr>
        <th>Name</th>
        <th>Role</th>
        <th class="r-num">Watch</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>Beverly Crusher</td>
        <td>Chief medical officer</td>
        <td class="r-num">1</td>
      </tr>
      <tr>
        <td>Geordi La Forge</td>
        <td>Chief engineer</td>
        <td class="r-num">2</td>
      </tr>
    </tbody>
  </table>
  
  <Notes
    markup={plain}
    classes="None; `.r-num` on a number column."
    do="Give a table a `caption`."
    dont="Use a table for layout."
  />

  <h3 class="sc-subhead">Key/value table</h3>
  <div class="sc-measure">
    <div class="r-kv"><table><tbody>
      <tr><th>name</th><td>Weekly report</td></tr>
      <tr><th>schedule</th><td>Mondays, 09:00</td></tr>
      <tr><th>owner</th><td><table><tbody>
        <tr><th>team</th><td>Ops</td></tr>
        <tr><th>email</th><td>ops@example.com</td></tr>
      </tbody></table></td></tr>
      <tr><th>format</th><td>PDF</td></tr>
    </tbody></table></div>
  </div>
  <Notes
    markup={kv}
    classes="`.r-kv` around the table. A value may be a table of its own."
    tokens="`--r-kv-line`."
    do="Use it for a record or settings."
    dont="Expect banding or hover."
  />
</section>
