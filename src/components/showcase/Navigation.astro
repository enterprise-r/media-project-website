---
// Navigation: the bar's crumbs and menus, as the theme ships them.
import Notes from "./Notes.astro";

const crumbs = `
<nav class="r-crumbs" aria-label="Breadcrumb">
  <ol>
    <li><a class="r-btn r-crumb-root" href="/">Home</a></li>
    <li>
      <details class="r-menu">
        <summary class="r-btn">Docs</summary>
        <div class="r-menu-list">
          <a class="r-btn" href="/guide/">Guide</a>
          <a class="r-btn" href="/reference/">Reference</a>
        </div>
      </details>
    </li>
    <li><a class="r-btn" href="/guide/" aria-current="page">Guide</a></li>
  </ol>
</nav>`;

const menus = `
<details class="r-menu r-to-right">
  <summary class="r-btn">Sort</summary>
  <div class="r-menu-list" role="menu" aria-label="Sort">
    <button type="button" class="r-btn" role="menuitemradio" aria-checked="true">Newest</button>
    <button type="button" class="r-btn" role="menuitemradio" aria-checked="false">Oldest</button>
  </div>
</details>

<details class="r-menu">
  <summary class="r-btn r-clear" aria-haspopup="menu">View</summary>
  <div class="r-menu-list" role="menu" aria-label="View">
    <a class="r-btn" role="menuitem" href="/print/">Print</a>
    <details class="r-menu r-side">
      <summary class="r-btn r-clear" role="menuitem" aria-haspopup="menu">Density</summary>
      <div class="r-menu-list" role="menu" aria-label="Density">
        <button type="button" class="r-btn" role="menuitemradio" aria-checked="true">Normal</button>
        <button type="button" class="r-btn" role="menuitemradio" aria-checked="false">Compact</button>
      </div>
    </details>
  </div>
</details>`;

const script = `
// One menu open at a time (a submenu and its parents stay open together); an outside click or Escape closes them.
const menus = [...document.querySelectorAll("details.r-menu")];
const close = (keep) => menus.forEach((m) => { if (!keep || !(m === keep || m.contains(keep) || keep.contains(m))) m.open = false; });
menus.forEach((m) => m.addEventListener("toggle", () => { if (m.open) close(m); }));
document.addEventListener("click", (e) => { if (!e.target.closest("details.r-menu")) close(); });
document.addEventListener("keydown", (e) => { if (e.key === "Escape") close(); });`;

const lone = `
<header class="r-bar">
  <nav class="r-crumbs" aria-label="Breadcrumb">
    <ol><li><a class="r-btn r-crumb-root" href="/" aria-current="page">Home</a></li></ol>
  </nav>
</header>`;
---
<section class="sc-section" id="navigation">
  <h2 class="sc-label">Navigation</h2>
  <header class="r-bar">
    <nav class="r-crumbs" aria-label="Breadcrumb">
      <ol>
        <li><a class="r-btn r-crumb-root" href="/"><picture><source media="(min-width: 48rem)" srcset="/assets/logo-wide-black.svg" width="320" height="56"><img src="/assets/logo-compact-black.svg" width="320" height="120" alt="Enterprise-R"></picture></a></li>
        <li>
          <details class="r-menu">
            <summary class="r-btn">Docs</summary>
            <div class="r-menu-list">
              <a class="r-btn" href="#navigation">Guide</a>
              <a class="r-btn" href="#navigation">Reference</a>
            </div>
          </details>
        </li>
        <li><a class="r-btn" href="#navigation" aria-current="page">Guide</a></li>
      </ol>
    </nav>
    <div class="r-bar-end">
      <span class="r-group">
        <details class="r-menu">
          <summary class="r-btn">Docs</summary>
          <div class="r-menu-list">
            <a class="r-btn" href="#navigation">Guide</a>
            <a class="r-btn" href="#navigation">Reference</a>
          </div>
        </details>
        <a class="r-btn" href="/">Home</a>
      </span>
    </div>
  </header>
  <p class="sc-note">The bar is the theme's. Breadcrumbs lead, and the group sits at the end. The root crumb here holds this site's black logo, as tall as the crumb (wide from 48rem, compact below); the theme paints only its striped fill at rest. On hover it takes the crumb hover. Parents are Magenta, Bright magenta on hover. The page you are on is Green (sage), Bright cyan on hover. A crumb can be a menu of its siblings. Focus on a crumb is a dual inner ring (dark then bright), because the slant would clip an outline.</p>

  <h3 class="sc-subhead">Breadcrumbs</h3>
  <Notes
    markup={crumbs}
    classes="`.r-crumbs` on the nav, `.r-btn` on each crumb, `.r-crumb-root` on the first. A crumb may be an `.r-menu` of its siblings."
    attributes={`\`aria-label="Breadcrumb"\` on the nav; \`aria-current="page"\` on the page you are on.`}
    tokens="`--r-crumb` and `--r-crumb-hover` (parents), `--r-primary` (current), `--r-btn-h` (height and slant)."
    do="Put the site's own label or logo inside `.r-crumb-root`; the root is a crumb like the others and only its fill at rest, the striped gradient, differs."
    dont="Style the root as a separate badge, or add an outline for focus: the slant clips it, so crumbs show focus as an inner ring."
  />

  <h3 class="sc-subhead">Menus</h3>
  <div class="sc-row sc-split">
    <details class="r-menu r-to-right">
      <summary class="r-btn">Sort</summary>
      <div class="r-menu-list" role="menu" aria-label="Sort">
        <button type="button" class="r-btn" role="menuitemradio" aria-checked="true">Newest</button>
        <button type="button" class="r-btn" role="menuitemradio" aria-checked="false">Oldest</button>
      </div>
    </details>
    <details class="r-menu">
      <summary class="r-btn r-clear" aria-haspopup="menu">View</summary>
      <div class="r-menu-list" role="menu" aria-label="View">
        <a class="r-btn" role="menuitem" href="#navigation">Print</a>
        <details class="r-menu r-side">
          <summary class="r-btn r-clear" role="menuitem" aria-haspopup="menu">Density</summary>
          <div class="r-menu-list" role="menu" aria-label="Density">
            <button type="button" class="r-btn" role="menuitemradio" aria-checked="true">Normal</button>
            <button type="button" class="r-btn" role="menuitemradio" aria-checked="false">Compact</button>
          </div>
        </details>
      </div>
    </details>
  </div>
  <Notes
    markup={menus}
    classes="`.r-menu` on a `details`, `.r-btn` on its `summary`, `.r-menu-list` around the items. `.r-to-right` opens the list from the left edge of its button instead of the right. `.r-side` on a menu inside a list makes a second level that fills the list's width and opens to its left."
    attributes={`A checked \`role="menuitemradio"\` (\`aria-checked="true"\`) is Green. An open menu on a role button (\`.r-primary\`, \`.r-clear\`, \`.r-cancel\`) keeps that role's hover.`}
    tokens="`--r-gap` (space between items), `--r-btn-hover` and the role hover tokens for an open button."
    js="None in the theme. Opening one menu at a time, closing on an outside click and on Escape, and checking a `menuitemradio` are left to the page. This page uses the script below."
    do="Use `.r-side` for a menu at the right edge of the window, so the second level opens toward the page."
    dont="Expect the theme to close menus; without a page script a menu stays open until its button is pressed again."
  >
    <pre class="sc-markup"><code>{script.trim()}</code></pre>
  </Notes>

  <h3 class="sc-subhead">Lone root crumb</h3>
  <header class="r-bar">
    <nav class="r-crumbs" aria-label="Breadcrumb">
      <ol><li><a class="r-btn r-crumb-root" href="#navigation" aria-current="page">Home</a></li></ol>
    </nav>
  </header>
  <Notes
    markup={lone}
    do="Narrow the window below 52rem to see the edge case in `bar.css`: a trail meets the window edge, and a lone first crumb is square on the left and still round on the right."
    dont="Expect a lone crumb to become a whole pill; it never does."
  />
</section>
