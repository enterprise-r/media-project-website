---
// Palette: the --ui-* tokens from the palette source, and how a page uses them.
import Notes from "./Notes.astro";
import palette from "../../styles/palette.json";

const groups = palette.groups.map((g) => ({ ...g, colours: g.colours.filter((c) => c.var !== "--ui-accent") }));
const accent = palette.groups.flatMap((g) => g.colours).filter((c) => c.var === "--ui-accent");

const use = `
.app-status { color: var(--ui-cyan); border-color: var(--ui-border); }
.app-hero { background: var(--ui-striped); }
.app-rule { height: 2px; background: var(--ui-separator); }`;
---
<section class="sc-section" id="palette">
  <h2 class="sc-label">Palette</h2>
  <div class="sc-brand-box">
    <h3 class="sc-subhead sc-top">Amber (Accent)</h3>
    <div class="sc-swatches">
      {accent.map((c) => (
        <div class="sc-swatch"><i style={`background:var(${c.var})`}></i><div><b>{c.name}</b><code>{c.hex}</code><small>{c.var} · {c.use}</small></div></div>
      ))}
    </div>
  </div>
  {groups.map((g) => (<>
    <h3 class="sc-subhead">{g.title}</h3>
    <div class="sc-swatches">
      {g.colours.map((c) => (<div class="sc-swatch"><i style={`background:var(${c.var})`}></i><div><b>{c.name}</b><code>{c.hex}</code><small>{c.var}{c.use && ` · ${c.use}`}</small></div></div>))}
    </div>
  </>))}
  <Notes
    markup={use}
    tokens="`--ui-bg` through `--ui-brown` (the colors above), `--ui-striped` (the striped gradient) and `--ui-separator` (the separator gradient), all from `palette.css`."
    do="Use a token by its variable; the hex values above are for reference only."
    dont="Copy a hex value into a stylesheet; a palette change would not reach it."
  />
</section>
