---
import { md } from "./md";

interface Props {
  markup?: string;
  extra?: string;
  classes?: string;
  attributes?: string;
  tokens?: string;
  js?: string;
  do?: string;
  dont?: string;
}
const p = Astro.props;
const rows = [
  ["Classes", p.classes],
  ["Attributes", p.attributes],
  ["Custom properties", p.tokens],
  ["JavaScript", p.js],
  ["Do", p.do],
  ["Don't", p.dont],
].filter(([, v]) => v) as [string, string][];
const hasCopy = Boolean(p.markup || p.extra);
const hasDocs = rows.length > 0;
const hasExtra = Astro.slots.has("default");
---
{(hasCopy || hasDocs || hasExtra) && (
  <div class="sc-notes">
    <details class="sc-code">
      <summary>Code</summary>
      {p.markup && <pre tabindex="0"><code>{p.markup.trim()}</code></pre>}
      {p.extra && <pre tabindex="0"><code>{p.extra.trim()}</code></pre>}
      {hasDocs && (
        <dl class="sc-spec">
          {rows.map(([k, v]) => (<><dt>{k}</dt><dd set:html={md(v)} /></>))}
        </dl>
      )}
      {hasExtra && <div class="sc-docs"><slot /></div>}
    </details>
  </div>
)}
