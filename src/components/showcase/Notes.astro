---
// Tutorial notes for one part of the theme. The code to copy sits in a closed details box
// (the theme's own details style), so the page reads as a showcase first; print leaves it out.
// Below it, a short list of what the part needs. Text in backticks is set as code.
import { md } from "./md";

interface Props {
  markup?: string;
  extra?: string;
  classes?: string;
  attributes?: string;
  tokens?: string;
  js?: string;
  do?: string;
  dont?: string;
}
const p = Astro.props;
const rows = [
  ["Classes", p.classes],
  ["Attributes", p.attributes],
  ["Custom properties", p.tokens],
  ["JavaScript", p.js],
  ["Do", p.do],
  ["Don't", p.dont],
].filter(([, v]) => v) as [string, string][];
---
<div class="sc-notes">
  {(p.markup || p.extra) && (
    <details class="sc-code">
      <summary>Code</summary>
      {p.markup && <pre><code>{p.markup.trim()}</code></pre>}
      {p.extra && <pre><code>{p.extra.trim()}</code></pre>}
    </details>
  )}
  {rows.length > 0 && (
    <dl class="sc-spec">
      {rows.map(([k, v]) => (<><dt>{k}</dt><dd set:html={md(v)} /></>))}
    </dl>
  )}
</div>
