---
// Home and 404 terminal: waiting icon, word carousel, static prompt.
// After a minute everything stops: the words join into one line, and the icon and logo go static.
import Motes from "./Motes.astro";
import "../styles/home.css";
import waitIcon from "../styles/theme/icons/wait.svg?url";
import waitStatic from "../styles/theme/icons/wait-static.svg?url";

interface Part {
  text: string;
  tone?: string | null;
}

interface Props {
  parts: Part[];
  // The static line under the words.
  prompt: string;
  // Screen-reader sentence, also shown when motion is reduced. Defaults to the words joined up.
  sentence?: string;
  // 404 only. The wide logo stays in this layout. throw-logo.js then flies that box.
  throwable?: boolean;
}

const { parts, prompt, sentence, throwable = false } = Astro.props;
const phrase = sentence ?? parts.map((p) => p.text).join(" ");
// The still line joins the words with spaces; a sentence like "404" joins them without.
const joiner = sentence ? "" : " ";
const countClass = parts.length === 3 ? "home-words home-words-3" : "home-words";

// W-words colour only the first W; every other tinted item is coloured in full.
const mark = (p: Part) =>
  p.tone
    ? p.text.startsWith("W") && p.text.length > 1
      ? { tone: p.tone, letter: "W", rest: p.text.slice(1) }
      : { tone: p.tone, letter: p.text, rest: "" }
    : { tone: null, letter: p.text, rest: "" };
---
<Motes />
<main class="home">
  <div class="home-stage">
    <div class="r-term home-wait">
      <div class="home-line">
        <img class="home-wait-icon" src={waitIcon} data-still={waitStatic} width="32" height="32" alt="">
        <p class="home-sentence">
          {sentence ? phrase : parts.map((p, i) => {
            const m = mark(p);
            return <>{i > 0 && " "}{m.tone ? <><span class={`home-w home-w-${m.tone}`}>{m.letter}</span>{m.rest}</> : m.letter}</>;
          })}
        </p>
        <span class={countClass} aria-hidden="true">
          {parts.map((p) => {
            const m = mark(p);
            return <span>{m.tone ? <><span class={`home-w home-w-${m.tone}`}>{m.letter}</span>{m.rest}</> : m.letter}</span>;
          })}
          <span class={sentence ? "home-still-line" : "home-still-line home-still-text"}>
            {parts.map((p, i) => {
              const m = mark(p);
              return <>{i > 0 && joiner}{m.tone ? <><span class={`home-w home-w-${m.tone}`}>{m.letter}</span>{m.rest}</> : m.letter}</>;
            })}
          </span>
        </span>
      </div>
      <p class="r-prompt home-status">{prompt}</p>
    </div>
    <img
      class="home-logo"
      src="/assets/logo-wide-pulse.svg"
      data-still="/assets/logo-wide.svg"
      width="320"
      height="56"
      alt=""
      draggable={throwable ? "false" : undefined}
      data-throwable={throwable ? "" : undefined}
    >
  </div>
</main>
<script>
  // After a minute: stop every animation and leave the joined words, the static W and the static logo.
  setTimeout(() => {
    document.querySelectorAll<HTMLImageElement>(".home [data-still]").forEach((img) => {
      img.src = img.dataset.still!;
    });
    document.documentElement.classList.add("home-still");
    document.dispatchEvent(new Event("home-still"));
  }, 60000);
</script>
