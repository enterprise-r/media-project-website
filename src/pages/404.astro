---
const page = {
  title: "Page not found · Enterprise-R",
  description: "This page does not exist.",
};
const parts = [
  { text: "4", tone: "orange" },
  { text: "0", tone: "magenta" },
  { text: "4", tone: "green" },
];
const prompt = "PAGE NOT FOUND";

import Base from "../layouts/Base.astro";
import HomeWait from "../components/HomeWait.astro";
---
<Base title={page.title} description={page.description} noindex hero>
  <HomeWait parts={parts} prompt={prompt} sentence="404" throwable />
</Base>
<script>
  import { throwLogo } from "../scripts/throw-logo.js";
  const el = document.querySelector("[data-throwable]");
  if (el) throwLogo(el);
</script>
