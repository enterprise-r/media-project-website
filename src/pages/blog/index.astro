---
const page = {
  title: "Blog · Enterprise-R",
  description: "Blog",
  heading: "Blog",
};

import Base from "../../layouts/Base.astro";
import "../../styles/theme/doc.css";
import "../../styles/blog.css";
import { feed, postHref, posts } from "../../blog";
---
<Base title={page.title} description={page.description}>
  <main class="r-column">
    <div class="r-doc">
      <div class="blog-title">
        <h1>{page.heading}</h1>
        <a class="blog-rss" href={feed.href} aria-label="RSS feed">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="6.18" cy="17.82" r="2.18"></circle>
            <path d="M4 4.44v2.83c7.03 0 12.73 5.7 12.73 12.73h2.83C19.56 11.41 12.59 4.44 4 4.44zm0 5.66v2.83c3.9 0 7.07 3.17 7.07 7.07h2.83c0-5.47-4.43-9.9-9.9-9.9z"></path>
          </svg>
        </a>
      </div>
      <ul>
        {posts.map((p) => (
          <li><a href={postHref(p)}>{p.title}</a></li>
        ))}
      </ul>
    </div>
  </main>
</Base>
