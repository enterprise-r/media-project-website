---
// Style guide and theme tutorial. Linked from the login page as the web UI. Not indexed, not in the sitemap.
// Each section is a component in src/components/showcase/.
import Base from "../layouts/Base.astro";
import DarkR from "../components/DarkR.astro";
import Greeting from "../components/showcase/Greeting.astro";
import GettingStarted from "../components/showcase/GettingStarted.astro";
import Navigation from "../components/showcase/Navigation.astro";
import Type from "../components/showcase/Type.astro";
import Buttons from "../components/showcase/Buttons.astro";
import Cards from "../components/showcase/Cards.astro";
import Form from "../components/showcase/Form.astro";
import Rows from "../components/showcase/Rows.astro";
import Guard from "../components/showcase/Guard.astro";
import Shell from "../components/showcase/Shell.astro";
import Tables from "../components/showcase/Tables.astro";
import Code from "../components/showcase/Code.astro";
import Separators from "../components/showcase/Separators.astro";
import Palette from "../components/showcase/Palette.astro";
import Accessibility from "../components/showcase/Accessibility.astro";
// The optional parts of the shell and the document scale, on this page only.
import "../styles/theme/foot.css";
import "../styles/theme/swatch.css";
import "../styles/theme/stripe.css";
import "../styles/theme/listing.css";
import "../styles/theme/kv.css";
import "../styles/theme/doc.css";
import "../styles/ui.css";
import palette from "../styles/palette.json";

const termBg = palette.groups.flatMap((g) => g.colours).find((c) => c.var === "--ui-bg").hex;
const contents = [
  ["getting-started", "Getting started"],
  ["navigation", "Navigation"],
  ["type", "Type"],
  ["buttons", "Buttons and pills"],
  ["cards", "Cards and panels"],
  ["form", "Form"],
  ["rows", "Dynamic list"],
  ["working", "Working"],
  ["shell", "App shell"],
  ["tables", "Tables"],
  ["code", "Code"],
  ["separators", "Separators"],
  ["palette", "Palette"],
  ["accessibility", "Accessibility"],
];
---
<Base title="UI showcase · Enterprise-R" description="Enterprise-R UI style guide." noindex header={false}>
  <main class="showcase">
    {/* The page heading is the big logo, right-aligned: the animated wide lockup, with the still one under
         reduced motion (as on the home page). */}
    <h1 class="sc-title">
      <picture>
        <source media="(prefers-reduced-motion: reduce)" srcset="/assets/logo-wide.svg">
        <img src="/assets/logo-wide-pulse.svg" width="320" height="56" alt="Enterprise-R">
      </picture>
    </h1>
    <p class="sc-subtitle">UI showcase</p>
    <Greeting />
    <p class="sc-lede"><DarkR />, the <span class="sc-brand">Enterprise-R</span> theme. Plain elements and the r- components, on the palette.</p>
    <p class="sc-lede"><DarkR /> is futuristic with a hint of retro, on a fresh palette you don't often see in everyday interfaces. It is made for night mode and for night-light filters that warm the screen in the evening. Its purples and magentas carry a lot of blue, so <DarkR /> changes more than most themes when the night light comes on.</p>
    <p class="sc-lede">Each part below is a live example. Open Code for the markup to copy; the list under it names what the part needs.</p>
    <nav class="sc-contents" aria-label="Contents">
      <ol>{contents.map(([id, label]) => <li><a href={`#${id}`}>{label}</a></li>)}</ol>
    </nav>

    <hr><GettingStarted />
    <hr><Navigation />
    <hr><Type />
    <hr><Buttons />
    <hr><Cards termBg={termBg} />
    <hr><Form />
    <hr><Rows />
    <hr><Guard />
    <hr><Shell />
    <hr><Tables />
    <hr><Code />
    <hr><Separators />
    <hr><Palette />
    <hr><Accessibility />

    <p class="sc-closer"><a class="sc-closer-fill" href="/" aria-label="Enterprise-R home"><DarkR /></a></p>
  </main>
  <footer><p class="sc-brand">Enterprise-R</p></footer>
  <script>
    import "../styles/theme/rows.js";
  </script>
  <script is:inline slot="scripts">
    // Menus: one open at a time, a submenu and its parents stay open together; click outside or Esc closes them.
    // The theme leaves that to the page.
    (() => {
      const menus = [...document.querySelectorAll("details.r-menu")];
      const close = (keep) => menus.forEach((m) => { if (!keep || !(m === keep || m.contains(keep) || keep.contains(m))) m.open = false; });
      menus.forEach((m) => m.addEventListener("toggle", () => { if (m.open) close(m); }));
      document.addEventListener("click", (e) => { if (!e.target.closest("details.r-menu")) close(); });
      document.addEventListener("keydown", (e) => { if (e.key === "Escape") close(); });
    })();
    // A menuitemradio checks itself and unchecks its siblings. The theme only paints the checked one.
    document.querySelectorAll('[role="menuitemradio"]').forEach((item) => item.addEventListener("click", () => {
      item.parentElement.querySelectorAll('[role="menuitemradio"]').forEach((other) => other.setAttribute("aria-checked", String(other === item)));
    }));
    // Indeterminate is a property only.
    document.getElementById("f-some").indeterminate = true;
    // Label contrast, from the colors on screen.
    (() => {
      const probe = document.body.appendChild(document.createElement("span"));
      const cs = getComputedStyle(document.documentElement);
      const hex = (v) => {
        const m = v.trim().match(/^#([0-9a-f]{6})$/i);
        if (m) return "#" + m[1].toUpperCase();
        const r = v.match(/rgba?\(([^)]+)\)/);
        if (!r) return v.trim();
        return "#" + r[1].split(",").slice(0, 3).map((n) => Math.round(parseFloat(n)).toString(16).padStart(2, "0")).join("").toUpperCase();
      };
      const lum = (h) => { const c = [1, 3, 5].map((i) => parseInt(h.slice(i, i + 2), 16) / 255).map((x) => (x <= 0.04045 ? x / 12.92 : ((x + 0.055) / 1.055) ** 2.4)); return 0.2126 * c[0] + 0.7152 * c[1] + 0.0722 * c[2]; };
      const ratio = (a, b) => { const [x, y] = [lum(a), lum(b)].sort((p, q) => q - p); return ((x + 0.05) / (y + 0.05)).toFixed(1); };
      const v = (t) => {
        const raw = cs.getPropertyValue(t).trim();
        if (raw.startsWith("var(")) { probe.style.color = raw; return hex(getComputedStyle(probe).color); }
        return hex(raw);
      };
      const label = v("--r-btn-text");
      document.getElementById("contrast").textContent =
        `Label contrast (WCAG AA needs 4.5:1): on current ${ratio(label, v("--r-primary"))}:1, on other ${ratio(label, v("--r-btn"))}:1, ` +
        `on current hover ${ratio(label, v("--r-primary-hover"))}:1, on other hover ${ratio(label, v("--r-btn-hover"))}:1, ` +
        `on clear ${ratio(label, v("--r-clear"))}:1 (hover ${ratio(label, v("--r-clear-hover"))}:1), on cancel ${ratio(label, v("--r-cancel"))}:1 (hover ${ratio(label, v("--r-cancel-hover"))}:1). ` +
        `Body text on the page background ${ratio(v("--r-text"), v("--ui-bg"))}:1.`;
      probe.remove();
    })();
    // Replay an update glow on a box: remove the class, force a reflow, add it back.
    function rGlow(el, kind) {
      el.classList.remove("r-glow", "r-glow-run");
      void el.offsetWidth;
      el.classList.add(kind);
    }
    document.querySelectorAll("[data-glow]").forEach((b) => b.addEventListener("click", () => {
      const v = document.getElementById("glow-v");
      v.textContent = (0.5 + Math.random() * 0.49).toFixed(2);
      ["glow-a", "glow-b", "glow-c", "glow-d"].forEach((id) => rGlow(document.getElementById(id), b.dataset.glow));
    }));
    document.querySelector("[data-glow-shape]").addEventListener("click", () => rGlow(document.getElementById("glow-e"), "r-glow-run"));
    // Status stripe: a change of status changes the role and flashes the border.
    document.getElementById("sc-stripe-done").addEventListener("click", () => {
      const stripe = document.getElementById("sc-stripe");
      const done = stripe.classList.contains("r-warn");
      stripe.classList.toggle("r-warn", !done);
      stripe.classList.toggle("r-ok", done);
      document.getElementById("sc-stripe-status").textContent = done ? "Done" : "Running";
      rGlow(stripe, "r-glow");
    });
    // Click guard samples: count the presses that reach the page.
    const count = (btn, out) => document.getElementById(btn).addEventListener("click", () => {
      const o = document.getElementById(out);
      o.textContent = String(Number(o.textContent) + 1);
    });
    count("sc-guard-btn", "sc-guard-n");
    count("sc-free-btn", "sc-free-n");
    document.getElementById("sc-guard-script").addEventListener("click", () => {
      const say = document.getElementById("sc-guard-say");
      say.textContent = "Clicking in 3 s…";
      setTimeout(() => {
        document.getElementById("sc-guard-btn").click();
        say.textContent = "Clicked from a script: the guarded counter rose.";
      }, 3000);
    });
    // A dynamic list added after load, enhanced with the rows.js hook.
    document.getElementById("sc-rows-add-list").addEventListener("click", () => {
      const later = document.getElementById("sc-rows-later");
      later.append(document.getElementById("sc-rows-tpl").content.cloneNode(true));
      window.rRows.enhance(later.lastElementChild);
    });
    document.getElementById("sc-print").addEventListener("click", () => window.print());
  </script>
</Base>
