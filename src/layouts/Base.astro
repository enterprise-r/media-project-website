---
// Shared page shell: head, favicons, title bar, navigation and footer.
import "../styles/palette.css";
import "../styles/theme/base.css";
import "../styles/theme/components.css";
import "../styles/theme/column.css";
import "../styles/theme/bar.css";
import "../styles/bar.css";
import "../styles/footer.css";
import Footer from "../components/Footer.astro";
import enterprsr from "../styles/fonts/woff2/Enterprsr-Regular.woff2?url";
import palette from "../styles/palette.json";
import { siteNoindex } from "../site";
import { feed } from "../blog";

interface Props {
  title: string;
  description: string;
  // Leave the page out of search engines. The style guide sets this.
  // SITE_NOINDEX leaves out every page.
  noindex?: boolean;
  // Title bar and footer. The style guide turns these off.
  header?: boolean;
  // Wallpaper, open stripes, and the home bar class. The 404 sets this.
  hero?: boolean;
  trail?: { href: string; label: string }[];
}
const { title, description, noindex = false, header = true, hero = false, trail = [] } = Astro.props;

const here = Astro.url.pathname.replace(/\/?$/, "/");
const isHome = here === "/";
const isAbout = here === "/about/";
const isHero = hero || isHome;
// 404 is the only hero that is not Home. It keeps the home chrome.
// Class is not-found: a class named is-404 is stripped by the dev CSS transform.
const isMissing = hero && !isHome;
// Right nav: links and submenus to the other pages.
// The page you are on is not listed there. It is the last breadcrumb, a self-link.
const pages = [
  { href: "/about/", label: "About" },
  { href: "/blog/", label: "Blog" },
  { href: "/r/", label: "Login" },
];
const crumbs = [
  { href: "/", label: "Home", root: true },
];
const section = pages.find((p) => here === p.href || here.startsWith(p.href));
if (section) crumbs.push({ href: section.href, label: section.label });
crumbs.push(...trail);
const nav = pages.filter((p) => here !== p.href && !here.startsWith(p.href));
const url = new URL(Astro.url.pathname, Astro.site).href;
// Browser chrome colour: the page background, read from the palette source.
const themeColor = palette.groups.flatMap((g) => g.colours).find((c) => c.var === "--ui-bg").hex;
---
<!DOCTYPE html>
<html lang="en" class:list={[isHero && "is-home", isMissing && "not-found", isAbout && "is-about"]}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="dark">
  <meta name="theme-color" content={themeColor}>
  <meta name="description" content={description}>
  {(noindex || siteNoindex) && <meta name="robots" content="noindex, nofollow">}
  <title>{title}</title>
  <link rel="preload" href={enterprsr} as="font" type="font/woff2" crossorigin>
  <meta property="og:type" content="website">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={url}>
  <link rel="alternate" type="application/rss+xml" title={feed.title} href={new URL(feed.href, Astro.site).href}>
  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/assets/favicon.ico" sizes="16x16 32x32 48x48">
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="192x192" href="/assets/icon-192.png">
  <link rel="icon" type="image/png" sizes="512x512" href="/assets/icon-512.png">
</head>
<body>
  {header && (
    <header class="r-bar">
      <nav class="r-crumbs" aria-label="Breadcrumb">
        <ol>
          {crumbs.map((c) => {
            const Tag = c.root && isHome ? "h1" : "a";
            const currentPage = c.root ? isHome : here === c.href;
            return (
              <li>
                <Tag
                  class:list={["r-btn", c.root && "r-crumb-root"]}
                  href={c.root && isHome ? undefined : c.href}
                  aria-current={currentPage ? "page" : undefined}
                >
                  {c.root ? (
                    <><picture><source media="(min-width: 48rem)" srcset="/assets/logo-wide-black.svg" width="320" height="56"><img src="/assets/logo-compact-black.svg" width="320" height="120" alt="Enterprise-R"></picture></>
                  ) : c.label}
                </Tag>
              </li>
            );
          })}
        </ol>
      </nav>
      {nav.length > 0 && (
        <div class="r-bar-end">
          <nav class="r-group" aria-label="Main">
            {nav.map((item) => (
              <a class="r-btn" href={item.href}>{item.label}</a>
            ))}
          </nav>
        </div>
      )}
    </header>
  )}
  <slot />
  {header && (
    <Footer />
  )}
  <script>
    import "../styles/theme/guard.js";
    import "../scripts/bar.js";
  </script>
  <slot name="scripts" />
</body>
</html>
